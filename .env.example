NODE_ENV=development
PORT=8000
APP_COUNTRY_API=https://collect-api.sws2apps.com/api/countries?
APP_CONGREGATION_API=https://collect-api.sws2apps.com/api/congregations?
# Extra app origins allowed to call this API, comma-separated (self-hosted app URL)
APP_TRUSTED_ORIGINS=
# Set to false when the server has no public internet (VPN-only or LAN deployments)
INTERNET_CHECK_ENABLED=true
# Set to false to stop sending visitor IPs to ipapi.co / freeipapi.com for session locations
VISITOR_GEOLOCATION_ENABLED=true
FIREBASE_APP_NAME=organized-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# firebase (default) or filesystem; filesystem keeps all records under STORAGE_DIRECTORY
STORAGE_BACKEND=firebase
STORAGE_DIRECTORY=
MAIL_ENABLED=false
# Required when MAIL_ENABLED=true
MAIL_ADDRESS=
MAIL_SENDER_NAME=
MAIL_PASSWORD=
# Optional SMTP server instead of Gmail; secure=false uses STARTTLS (e.g. port 587)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
# Development-only example. Production must use a unique secret from its secret store.
SEC_ENCRYPT_KEY=organized-local-a0a7be20e1f82141d915b1212d8db451c09ae6fa76dd89d78f8063fb1c148909
